# 拡張子なしのきれいなURL（/faq, /company など）で .html を配信する
Options -MultiViews
RewriteEngine On

# /faq.html など .html付きの直接アクセスは拡張子なしへ301リダイレクト（URLの正規化）
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# 拡張子なしのリクエストに対応する .html ファイルがあれば内部的に配信
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
